# ---------------------------------------------------------------------------
# YFJ Matrimony — frontend environment variables
# Copy to .env.local (dev), .env.staging or .env.production and fill in values.
# Only PUBLIC, non-sensitive values belong here. Never put AWS secret keys,
# database passwords, JWT signing secrets or payment secret keys in this file.
# ---------------------------------------------------------------------------

# Base URL of the backend REST API:
# Local dev with backend: http://localhost:5000/api
# Production (AWS App Runner): https://<your-apprunner-id>.<region>.awsapprunner.com/api
VITE_API_BASE_URL=http://localhost:5000/api

# Google OAuth *client id* (public by design) used for "Continue with Google"
VITE_GOOGLE_CLIENT_ID=

# Payment gateway PUBLISHABLE key (Razorpay key_id / Stripe pk_...)
VITE_PAYMENT_PUBLIC_KEY=

# Optional: websocket endpoint for realtime chat (wss://...)
VITE_CHAT_SOCKET_URL=

# Display name used in page titles
VITE_APP_NAME=YFJ Matrimony

# Set to "false" once the backend is available to disable the bundled mock API
VITE_USE_MOCK_API=true

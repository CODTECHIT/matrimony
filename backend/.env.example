# =============================================================================
# YFJ Matrimony Backend Environment Variables (AWS EC2 + RDS + S3)
# =============================================================================

PORT=5000
NODE_ENV=production
JWT_SECRET=your_super_secret_jwt_key_change_in_production
CORS_ORIGIN=http://localhost:8080,https://yfjmatrimony.com,https://*.vercel.app

# -----------------------------------------------------------------------------
# AWS RDS PostgreSQL Database Configuration
# -----------------------------------------------------------------------------
# Option 1: Full Connection URL
DATABASE_URL=postgresql://postgres:YourSecurePassword@your-rds-instance.xxxxxx.ap-south-1.rds.amazonaws.com:5432/yfj_matrimony?sslmode=require

# Option 2: Discrete parameters (if DATABASE_URL is not provided)
DB_HOST=your-rds-instance.xxxxxx.ap-south-1.rds.amazonaws.com
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=YourSecurePassword
DB_NAME=yfj_matrimony
DB_SSL=true

# -----------------------------------------------------------------------------
# AWS S3 & CloudFront Media / Video Storage
# -----------------------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=yfj-matrimony-media-prod

# If running on EC2 with an attached IAM Role, you can leave these blank!
# EC2 will automatically authenticate using the IAM Instance Profile.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: CloudFront CDN distribution URL for high-speed global media caching
AWS_CLOUDFRONT_DOMAIN=https://d1234abcd56789.cloudfront.net
